# Copia questo file in .env e inserisci le tue chiavi.
ANTHROPIC_API_KEY=sk-ant-...

# Stripe: chiave segreta (di test: sk_test_...) da https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Segreto whsec_... stampato da "stripe listen" (in locale) o dall'endpoint webhook in dashboard
STRIPE_WEBHOOK_SECRET=

# Facoltativi
# ADMIN_EMAILS=tua@email.com
# INITIAL_CREDITS=0
# SESSION_DAYS=30
# APP_BASE_URL=http://localhost:8520
